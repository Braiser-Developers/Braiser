{
  "manifest_version": 3,
  "name": "Braiser",
  "version": "0.2.0",
  "description": "让 Agent 通过 MCP 操作浏览器的轻量级工具。",
  "permissions": ["activeTab", "debugger", "downloads", "scripting", "storage", "tabGroups", "tabs"],
  "host_permissions": [
    "ws://127.0.0.1:17832/*",
    "<all_urls>"
  ],
  "background": {
    "service_worker": "dist/background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Braiser"
  }
}
